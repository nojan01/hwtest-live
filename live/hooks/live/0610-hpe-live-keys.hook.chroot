#!/bin/sh
# Sonderzeichen ohne AltGr: Ueber die iLO-HTML5-Konsole kommt AltGr oft nicht im System an,
# auf deutscher Tastatur fehlen dann | \ @ ~ { } [ ] €. Zwei unabhaengige Wege:
#  1) Grafische Oberflaeche (jedes Fenster): Strg+Alt+<Taste des Zeichens> tippt das Zeichen
#     (Openbox-Kuerzel -> hpe-live-type/xdotool). Zusaetzlich Strg+AltGr+Taste, falls die
#     Konsole AltGr als Strg+AltGr durchreicht.
#  2) Shell (bash/readline, auch Textkonsole, seriell, SSH): F-Tasten fuegen die Zeichen ein.
# Belegung fuer den Benutzer: /usr/local/share/hpe-live/sonderzeichen.txt (hpe-live-keys).
# Idempotent; wird auch vom Alma-Build aufgerufen.
set -eu

if [ -f /etc/inputrc ] && ! grep -q 'hpe-live: Sonderzeichen' /etc/inputrc; then
    # F2-F4 senden je nach Terminal ESC O Q/R/S (xterm) oder ESC [ [ B/C/D (Textkonsole)
    cat >>/etc/inputrc <<'EOF'

# hpe-live: Sonderzeichen auf F-Tasten (iLO-Konsole ohne AltGr), siehe hpe-live-keys
"\eOQ": "@"
"\e[[B": "@"
"\e[12~": "@"
"\eOR": "~"
"\e[[C": "~"
"\e[13~": "~"
"\eOS": "\\"
"\e[[D": "\\"
"\e[14~": "\\"
"\e[17~": "["
"\e[18~": "]"
"\e[19~": "|"
"\e[20~": "{"
"\e[21~": "}"
EOF
fi

rc=/etc/xdg/openbox/rc.xml
if [ -f "$rc" ] && ! grep -q 'hpe-live-type' "$rc"; then
    binds=""
    add() {  # add OPENBOX-TASTE XDOTOOL-TASTE NAME
        binds="$binds  <keybind key=\"$1\"><action name=\"Execute\"><command>hpe-live-type -k $2 $3</command></action></keybind>\\n"
    }
    # Taste = Position des Zeichens auf der deutschen Tastatur (wie AltGr), als Keycode der
    # physischen Taste (evdev): Openbox loest Tastennamen wie "less" sonst ueber die erste Taste
    # auf, die das Zeichen in irgendeiner Ebene traegt (z. B. "<" auf AltGr+Umschalt+X).
    # 94 = <  20 = ß  24 = Q  35 = +  16 = 7  19 = 0  17 = 8  18 = 9  26 = E  33 = P  74 = F8
    for entry in 94:pipe 20:backslash 24:at 35:tilde 16:lbrace 19:rbrace 17:lbracket 18:rbracket 26:euro; do
        code=${entry%%:*}; name=${entry#*:}
        hex=$(printf '0x%x' "$code")
        add "C-A-$hex" "$code" "$name"
        add "C-Mod5-$hex" "$code" "$name"
    done
    add "C-A-0x21" 33 pipe
    add "S-0x4a" 74 pipe
    sed -i "s#</keyboard>#$binds</keyboard>#" "$rc"
    grep -q 'hpe-live-type' "$rc" || echo "WARNUNG: Openbox-Tastenkuerzel fuer Sonderzeichen nicht eingetragen" >&2
fi
