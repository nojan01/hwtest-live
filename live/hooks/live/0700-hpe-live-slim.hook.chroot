#!/bin/sh
# Verkleinert das Image: nicht benötigte Kernelmodule und Caches entfernen.
set -eu

STRIP_KERNEL_MODULES=1
[ -r /live-build/config/hpe-live.conf ] && . /live-build/config/hpe-live.conf

KVER=$(ls /lib/modules | sort -V | tail -n1)
M="/lib/modules/${KVER}/kernel"

if [ "${STRIP_KERNEL_MODULES}" = "1" ] && [ -d "$M" ]; then
    graphics=""
    for mod in i915 xe amdgpu radeon nouveau drm_display_helper cec; do
        if modinfo -k "${KVER}" "$mod" >/dev/null 2>&1; then
            graphics="$graphics $mod"
        fi
    done
    before=$(du -sm "$M" | cut -f1)
    for d in \
        sound \
        drivers/media/usb \
        drivers/media/pci \
        drivers/media/dvb-frontends \
        drivers/media/tuners \
        drivers/media/i2c \
        drivers/media/radio \
        drivers/media/platform \
        drivers/media/test-drivers \
        drivers/media/common \
        drivers/media/v4l2-core \
        drivers/media/dvb-core \
        drivers/media/mc \
        drivers/staging \
        drivers/net/wireless \
        drivers/bluetooth \
        drivers/isdn \
        drivers/iio \
        drivers/input/joystick \
        drivers/input/touchscreen \
        drivers/input/tablet \
        net/wireless \
        net/mac80211 \
        net/bluetooth
    do
        rm -rf "${M:?}/${d}"
    done
    # drivers/media/cec bleibt: drm_display_helper (i915, xe, amdgpu, radeon, nouveau)
    # braucht cec.ko, und cec.ko braucht rc-core.ko (drivers/media/rc) – ohne beide
    # lädt kein Grafiktreiber ("unknown symbol", X fällt auf 800x600 zurück).
    # Aus drivers/media/rc bleibt daher nur rc-core, alle IR-Empfänger fliegen raus.
    find "${M}/drivers/media/rc" -type f ! -name 'rc-core.ko*' -delete 2>/dev/null || true
    find "${M}/drivers/media/rc" -mindepth 1 -type d -empty -delete 2>/dev/null || true
    # Grafiktreiber (amdgpu, radeon, i915, xe, nouveau) bleiben; nouveau ist mit
    # proprietärem NVIDIA-Treiber per Kernel-Parameter gesperrt (Bootmenü-Notlösung).
    depmod -a "${KVER}"
    # depmod warnt nicht zuverlässig über gelöschte Abhängigkeiten – daher die
    # "depends"-Kette der Grafiktreiber rekursiv gegen das Dateisystem prüfen.
    missing=""
    checked=" "
    queue="$graphics"
    while [ -n "$queue" ]; do
        set -- $queue
        [ $# -gt 0 ] || break
        mod=$1; shift; queue="$*"
        case "$checked" in *" $mod "*) continue;; esac
        checked="$checked$mod "
        file=$(modinfo -k "${KVER}" -n "$mod" 2>/dev/null || true)
        if [ "$file" != "(builtin)" ] && { [ -z "$file" ] || [ ! -f "$file" ]; }; then
            missing="$missing $mod"
            continue
        fi
        deps=$(modinfo -k "${KVER}" -F depends "$mod" 2>/dev/null | tr ',' ' ')
        queue="$queue $deps"
    done
    if [ -n "$missing" ]; then
        echo "hpe-live: Kernelmodule mit fehlenden Abhängigkeiten:$missing" >&2
        exit 1
    fi
    echo "hpe-live: Kernelmodule ${before} MB -> $(du -sm "$M" | cut -f1) MB"
fi

# Firmware ohne Bezug zu Test-PCs/Servern (z.B. aus firmware-misc-nonfree);
# Grafik-Firmware (amdgpu, radeon, i915, xe, nvidia) bleibt erhalten.
rm -rf /lib/firmware/ath* /lib/firmware/iwlwifi* /lib/firmware/brcm \
    /lib/firmware/mediatek /lib/firmware/rtw88 /lib/firmware/rtw89 /lib/firmware/mrvl/prestera 2>/dev/null || true

# Vulkan-Treiber ohne Bezug zu PC-/Server-Hardware (Apple, Android-Emulator, virtio)
rm -f /usr/share/vulkan/icd.d/asahi_icd.* /usr/share/vulkan/icd.d/gfxstream_vk_icd.* \
    /usr/share/vulkan/icd.d/virtio_icd.* /usr/lib/x86_64-linux-gnu/libvulkan_asahi.so \
    /usr/lib/x86_64-linux-gnu/libvulkan_gfxstream.so /usr/lib/x86_64-linux-gnu/libvulkan_virtio.so

rm -rf /usr/share/doc-base /var/cache/apt/*.bin /var/cache/debconf/*-old \
    /var/lib/apt/lists/* /var/log/apt/* 2>/dev/null || true
find /usr/share/doc -mindepth 1 -not -name copyright -not -type d -delete 2>/dev/null || true
find /usr/share/doc -mindepth 1 -type d -empty -delete 2>/dev/null || true

# NVIDIA DCGM: nur die CUDA-Bibliotheken behalten, die die Diagnose-Plugins
# (dcgmi diag -r 1..4: Software, PCIe, Memory, Memtest, Diagnostic, Targeted
# Stress/Power, NVBandwidth) tatsächlich laden - cuBLAS/cuBLASLt. cuSPARSELt,
# cuRAND und NCCL (~570 MB) werden von keinem Standard-Plugin referenziert;
# der NCCL-Test ist bei keiner Stufe enthalten (nur explizit "-r nccl").
DCGM=/usr/libexec/datacenter-gpu-manager-4
if [ -d "$DCGM" ]; then
    before=$(du -sm "$DCGM" | cut -f1)
    rm -f "$DCGM"/cuda*/lib/libcusparseLt* "$DCGM"/cuda*/lib/libcurand* "$DCGM"/cuda*/lib/libnccl* \
        "$DCGM"/cuda*/lib/updated/libcusparseLt* "$DCGM"/cuda*/lib/updated/libcurand* \
        "$DCGM"/cuda*/lib/updated/libnccl* "$DCGM"/plugins/cuda*/libNcclTests*
    echo "hpe-live: DCGM ${before} MB -> $(du -sm "$DCGM" | cut -f1) MB (ohne cuSPARSELt/cuRAND/NCCL)"
fi

# Alma installiert diese Treiberdateien per RPM; Debian schliesst sie bereits
# beim Entpacken aus. CUDA, NVML, cuBLAS und die Grafiktreiber bleiben erhalten.
for libdir in /usr/lib64 /usr/lib/x86_64-linux-gnu; do
    rm -f "$libdir"/libnvoptix.so* "$libdir"/libnvidia-opencl.so* \
        "$libdir"/libnvcuvid.so* "$libdir"/libcudadebugger.so* \
        "$libdir"/libnvidia-present.so*
done
rm -f /usr/share/nvidia/nvoptix.bin

# NVIDIA MFT: Register-Dump-Datenbanken (mstdump, ~50 MB) werden nicht benötigt;
# mlxconfig/mlxfwmanager/mlxlink arbeiten ohne sie.
rm -rf /usr/share/mft/mstdump_dbs 2>/dev/null || true

# Übersetzungen: nur Deutsch und Englisch behalten (Hardwaretest bringt eigene mit)
if [ -d /usr/share/locale ]; then
    find /usr/share/locale -mindepth 1 -maxdepth 1 -type d \
        ! -name 'de' ! -name 'de_*' ! -name 'en' ! -name 'en_*' ! -name 'C' ! -name 'locale.alias' \
        -exec rm -rf {} + 2>/dev/null || true
fi
find /usr/share/man -mindepth 1 -maxdepth 1 -type d -name '??*' ! -name 'man*' ! -name 'de*' ! -name 'en*' -exec rm -rf {} + 2>/dev/null || true
