# Hardwaretest Live – schlanke Taskleiste
panel_items = LTSC
panel_size = 100% 34
panel_position = bottom center horizontal
panel_background_id = 1
wm_menu = 1
panel_dock = 0
font_shadow = 0
rounded = 0
border_width = 0
background_color = #11161c 100
border_color = #000000 0

launcher_padding = 4 4 4
launcher_icon_size = 26
launcher_icon_theme_override = 0
launcher_tooltip = 1
launcher_item_app = /usr/local/share/applications/hpe-hardwaretest.desktop
launcher_item_app = /usr/local/share/applications/hpe-json-viewer.desktop
launcher_item_app = /usr/local/share/applications/hpe-terminal.desktop
launcher_item_app = /usr/local/share/applications/hpe-btop.desktop

taskbar_mode = single_desktop
taskbar_padding = 2 2 4
task_text = 1
task_icon = 1
task_centered = 0
task_maximum_size = 220 32
task_padding = 4 2 4
task_font = DejaVu Sans 9
task_font_color = #e0e0e0 100
task_active_font_color = #ffffff 100
task_active_background_id = 1

systray_padding = 2 2 4
systray_icon_size = 20

time1_format = %H:%M
time2_format = %d.%m.%Y
time1_font = DejaVu Sans Bold 9
time2_font = DejaVu Sans 7
clock_font_color = #e0e0e0 100
clock_padding = 6 0
