# ZFS (Kernelmodul wird per DKMS beim Build gebaut, Toolchain danach entfernt)
zfsutils-linux
zfs-dkms
linux-headers-amd64
# Dateisystemprüfung in Hardwaretest (xfs, btrfs, vfat, squashfs) – nur lesend
xfsprogs
btrfs-progs
dosfstools
squashfs-tools
# Reparaturwerkzeuge für den Administrator (Hardwaretest selbst repariert nicht):
# e2fsck/xfs_repair/btrfs/fsck.fat (oben), ntfsfix, fsck.exfat, gdisk, testdisk/photorec
ntfs-3g
exfatprogs
gdisk
testdisk
# Grafische Partitionierung (Administrator); FAT16/FAT32 braucht dosfstools (oben)
# und mtools (Label/UUID lesen und ändern)
gparted
mtools
# VMware-ESXi-Datenspeicher lesend prüfen (fsck.vmfs6 / fsck.vmfs, Hardwaretest Dateisystem-Tab)
vmfs6-tools
vmfs-tools
